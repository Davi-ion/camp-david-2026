// Camp David 2026 — Phase 3: Full Camp Management System

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "sqlite"
}

// ─── Staff / Users ───────────────────────────────────────────────
model Staff {
  id                  String    @id @default(cuid())
  name                String
  email               String?   @unique
  username            String?   @unique
  passwordHash        String?
  pin                 String?
  role                String    @default("staff")
  department          String?
  group               String?   // legacy platoon assignment string
  platoonId           String?   // FK to Platoon model
  phone               String?
  gender              String?
  avatar              String?
  bio                 String?
  address             String?
  emergencyContact    String?   // JSON: { name, phone, relationship }
  status              String    @default("active")
  forcePasswordChange Boolean   @default(true)
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?
  lastLoginAt         DateTime?
  createdBy           String?
  tasks               String?   // JSON
  availability        String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  // Relations
  platoon             Platoon?          @relation("PlatoonStaff", fields: [platoonId], references: [id])
  ledPlatoons         Platoon[]         @relation("PlatoonLeader")
  roleAssignment      RoleAssignment?
  auditLogs           AuditLog[]        @relation("UserAuditLogs")
  notifications       Notification[]
  passwordResetTokens PasswordResetToken[]
  assignedIncidents   Incident[]        @relation("IncidentAssignedStaff")
  reportedIncidents   Incident[]        @relation("IncidentReporter")
  counselledCampers   Camper[]          @relation("CounsellorCampers")
}

// ─── Platoons ─────────────────────────────────────────────────────
model Platoon {
  id          String   @id @default(cuid())
  name        String   @unique
  emoji       String   @default("🏴")
  description String?
  leaderId    String?
  colorHex    String?  @default("#1B7865")
  status      String   @default("active")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  leader  Staff?   @relation("PlatoonLeader", fields: [leaderId], references: [id])
  staff   Staff[]  @relation("PlatoonStaff")
  campers Camper[]
}

// ─── Campers ─────────────────────────────────────────────────────
model Camper {
  id                 String    @id @default(cuid())
  registrationNumber String?   @unique
  name               String
  dateOfBirth        String?
  age                Int?
  gender             String?
  photo              String?   // URL or base64
  platoonId          String?
  medicalNotes       String?
  allergies          String?
  medications        String?
  bloodGroup         String?
  emergencyContact   String?   // JSON: { name, phone, relationship }
  guardianName       String?
  guardianPhone      String?
  guardianEmail      String?
  guardianRelation   String?
  address            String?
  notes              String?
  dietaryRestrictions String?
  church             String?
  qrCode             String?   @unique
  counsellorId       String?
  status             String    @default("active") // active | inactive | transferred
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  platoon    Platoon?   @relation(fields: [platoonId], references: [id])
  counsellor Staff?     @relation("CounsellorCampers", fields: [counsellorId], references: [id])
  incidents  Incident[] @relation("IncidentCamper")
}

// ─── Incidents ────────────────────────────────────────────────────
model Incident {
  id             String    @id @default(cuid())
  title          String
  description    String
  category       String    @default("other") // medical | behaviour | security | safety | lost_property | other
  severity       String    @default("low")   // low | medium | high | critical
  status         String    @default("open")  // open | in_progress | resolved | closed
  camperId       String?
  assignedStaffId String?
  reportedById   String?
  location       String?
  resolution     String?
  followUp       String?
  reportedAt     DateTime  @default(now())
  resolvedAt     DateTime?
  updatedAt      DateTime  @updatedAt

  camper        Camper? @relation("IncidentCamper", fields: [camperId], references: [id])
  assignedStaff Staff?  @relation("IncidentAssignedStaff", fields: [assignedStaffId], references: [id])
  reportedBy    Staff?  @relation("IncidentReporter", fields: [reportedById], references: [id])
}

// ─── Announcements ────────────────────────────────────────────────
model Announcement {
  id          String    @id @default(cuid())
  title       String
  body        String
  urgent      Boolean   @default(false)
  pinned      Boolean   @default(false)
  archived    Boolean   @default(false)
  targetType  String    @default("all") // all | platoon | role | individual
  targetId    String?   // platoonId or roleId or staffId
  scheduledAt DateTime?
  authorId    String?
  authorName  String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

// ─── Camp Settings ────────────────────────────────────────────────
model CampSettings {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt
}

// ─── Roles ────────────────────────────────────────────────────────
model Role {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  permissions String   @default("[]")
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  assignments RoleAssignment[]
}

model RoleAssignment {
  id        String   @id @default(cuid())
  staffId   String   @unique
  roleId    String
  createdAt DateTime @default(now())

  staff Staff @relation(fields: [staffId], references: [id], onDelete: Cascade)
  role  Role  @relation(fields: [roleId], references: [id], onDelete: Cascade)
}

// ─── Audit Log ───────────────────────────────────────────────────
model AuditLog {
  id           String   @id @default(cuid())
  userId       String
  userName     String
  action       String
  targetType   String?
  targetId     String?
  targetName   String?
  detail       String?
  ipAddress    String?
  createdAt    DateTime @default(now())

  user Staff @relation("UserAuditLogs", fields: [userId], references: [id], onDelete: Cascade)
}

// ─── Notifications ───────────────────────────────────────────────
model Notification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  message   String
  type      String   @default("info")
  isRead    Boolean  @default(false)
  link      String?
  createdAt DateTime @default(now())

  user Staff @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ─── Password Reset Tokens ────────────────────────────────────────
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user Staff @relation(fields: [userId], references: [id], onDelete: Cascade)
}
