// Camp David 2026 — Phase 3: Full Camp Management System

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Staff / Users ───────────────────────────────────────────────
model Staff {
  id                  String    @id @default(cuid())
  name                String
  email               String?   @unique
  username            String?   @unique
  passwordHash        String?
  pin                 String?
  role                String    @default("staff")
  department          String?
  group               String?   // legacy platoon assignment string
  platoonId           String?   // FK to Platoon model
  phone               String?
  gender              String?
  avatar              String?
  bio                 String?
  address             String?
  emergencyContact    String?   // JSON: { name, phone, relationship }
  status              String    @default("active")
  forcePasswordChange Boolean   @default(true)
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?
  lastLoginAt         DateTime?
  createdBy           String?
  tasks               String?   // JSON
  availability        String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  // Relations
  platoon             Platoon?          @relation("PlatoonStaff", fields: [platoonId], references: [id])
  ledPlatoons         Platoon[]         @relation("PlatoonLeader")
  roleAssignment      RoleAssignment?
  auditLogs           AuditLog[]        @relation("UserAuditLogs")
  notifications       Notification[]
  passwordResetTokens PasswordResetToken[]
  assignedIncidents   Incident[]        @relation("IncidentAssignedStaff")
  reportedIncidents   Incident[]        @relation("IncidentReporter")
  counselledCampers   Camper[]          @relation("CounsellorCampers")

  // Phase 6 Drills
  assignedDrills      CampDrill[]       @relation("AssignedDrills")
  backupDrills        CampDrill[]       @relation("BackupDrills")

  // Phase 7 Announcements
  announcementReads   AnnouncementRead[]
  
  // Phase 10 Dorms
  supervisedDorms          Dorm[] @relation("DormSupervisor")
  assistantSupervisedDorms Dorm[] @relation("DormAssistantSupervisor")
}

// ─── Platoons ─────────────────────────────────────────────────────
model Platoon {
  id          String   @id @default(cuid())
  name        String   @unique
  emoji       String   @default("🏴")
  description String?
  leaderId    String?
  colorHex    String?  @default("#1B7865")
  status      String   @default("active")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  leader  Staff?   @relation("PlatoonLeader", fields: [leaderId], references: [id])
  staff   Staff[]  @relation("PlatoonStaff")
  campers Camper[]
  drills  CampDrill[] @relation("PlatoonDrills")
}

// ─── Dorms ────────────────────────────────────────────────────────
model Dorm {
  id          String   @id @default(cuid())
  name        String   @unique
  gender      String   // "male" | "female"
  capacity    Int      @default(50)
  status      String   @default("active")
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  supervisorId          String?
  assistantSupervisorId String?

  campers             Camper[]
  supervisor          Staff?   @relation("DormSupervisor", fields: [supervisorId], references: [id])
  assistantSupervisor Staff?   @relation("DormAssistantSupervisor", fields: [assistantSupervisorId], references: [id])
}

// ─── Campers ─────────────────────────────────────────────────────
model Camper {
  id                 String    @id @default(cuid())
  registrationNumber String?   @unique
  name               String
  dateOfBirth        String?
  age                Int?
  gender             String?
  photo              String?   // URL or base64
  platoonId          String?
  dormId             String?
  bedNumber          String?
  dormNotes          String?
  medicalNotes       String?
  allergies          String?
  medications        String?
  bloodGroup         String?
  emergencyContact   String?   // JSON: { name, phone, relationship }
  guardianName       String?
  guardianPhone      String?
  guardianEmail      String?
  guardianRelation   String?
  address            String?
  notes              String?
  dietaryRestrictions String?
  church             String?
  qrCode             String?   @unique
  counsellorId       String?
  status             String    @default("active") // active | inactive | transferred
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  platoon    Platoon?   @relation(fields: [platoonId], references: [id])
  dorm       Dorm?      @relation(fields: [dormId], references: [id])
  counsellor Staff?     @relation("CounsellorCampers", fields: [counsellorId], references: [id])
  incidents  Incident[] @relation("IncidentCamper")
}

// ─── Incidents ────────────────────────────────────────────────────
model Incident {
  id             String    @id @default(cuid())
  title          String
  description    String
  category       String    @default("other") // medical | behaviour | security | safety | lost_property | other
  severity       String    @default("low")   // low | medium | high | critical
  status         String    @default("open")  // open | in_progress | resolved | closed
  camperId       String?
  assignedStaffId String?
  reportedById   String?
  location       String?
  resolution     String?
  followUp       String?
  reportedAt     DateTime  @default(now())
  resolvedAt     DateTime?
  updatedAt      DateTime  @updatedAt

  camper        Camper? @relation("IncidentCamper", fields: [camperId], references: [id])
  assignedStaff Staff?  @relation("IncidentAssignedStaff", fields: [assignedStaffId], references: [id])
  reportedBy    Staff?  @relation("IncidentReporter", fields: [reportedById], references: [id])
}

// ─── Announcements ────────────────────────────────────────────────
model Announcement {
  id          String    @id @default(cuid())
  title       String
  body        String
  category    String    @default("General")
  priority    String    @default("normal") // low, normal, high, critical
  status      String    @default("published") // draft, scheduled, published, archived
  isEmergency Boolean   @default(false)
  pinned      Boolean   @default(false)
  targetType  String    @default("all") // all | platoon | role | department | individual
  targetId    String?   
  scheduledAt DateTime?
  expiryDate  DateTime?
  authorId    String?
  authorName  String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  readReceipts AnnouncementRead[]
}

model AnnouncementRead {
  id             String       @id @default(cuid())
  announcementId String
  userId         String
  readAt         DateTime     @default(now())

  announcement   Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  user           Staff        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([announcementId, userId])
}

// ─── Camp Settings ────────────────────────────────────────────────
model CampSettings {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt
}

// ─── Roles ────────────────────────────────────────────────────────
model Role {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  permissions String   @default("[]")
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  assignments RoleAssignment[]
}

model RoleAssignment {
  id        String   @id @default(cuid())
  staffId   String   @unique
  roleId    String
  createdAt DateTime @default(now())

  staff Staff @relation(fields: [staffId], references: [id], onDelete: Cascade)
  role  Role  @relation(fields: [roleId], references: [id], onDelete: Cascade)
}

// ─── Audit Log ───────────────────────────────────────────────────
model AuditLog {
  id           String   @id @default(cuid())
  userId       String
  userName     String
  action       String
  targetType   String?
  targetId     String?
  targetName   String?
  detail       String?
  ipAddress    String?
  createdAt    DateTime @default(now())

  user Staff @relation("UserAuditLogs", fields: [userId], references: [id], onDelete: Cascade)
}

// ─── Notifications ───────────────────────────────────────────────
model Notification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  message   String
  type      String   @default("info")
  category  String   @default("General")
  priority  String   @default("normal") // low, normal, high, critical
  isRead    Boolean  @default(false)
  link      String?
  createdAt DateTime @default(now())

  user Staff @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ─── Password Reset Tokens ────────────────────────────────────────
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user Staff @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ─── Phase 6: Camp Drills ─────────────────────────────────────────

model CampDrill {
  id                String   @id @default(cuid())
  name              String
  category          String   @default("General")
  description       String?
  assignedStaffId   String?
  backupStaffId     String?
  sessionId         String?  // Links to static schedule key, e.g. "wed-morning-devotion"
  platoonId         String?
  department        String?
  date              String?  // e.g., "2026-07-29"
  startTime         String?  // "09:00"
  endTime           String?
  venue             String?
  priority          String   @default("medium") // low, medium, high, critical
  status            String   @default("upcoming") // upcoming, in_progress, completed, cancelled, overdue
  instructions      String?
  requiredEquipment String?
  notes             String?
  completionNotes   String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  assignedStaff     Staff?   @relation("AssignedDrills", fields: [assignedStaffId], references: [id])
  backupStaff       Staff?   @relation("BackupDrills", fields: [backupStaffId], references: [id])
  platoon           Platoon? @relation("PlatoonDrills", fields: [platoonId], references: [id])
  checklist         DrillChecklistItem[]
}

model DrillChecklistItem {
  id          String   @id @default(cuid())
  drillId     String
  text        String
  isCompleted Boolean  @default(false)
  completedAt DateTime?

  drill       CampDrill @relation(fields: [drillId], references: [id], onDelete: Cascade)
}
